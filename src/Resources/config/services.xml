<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="CodeCom\FreshdeskSyncCustomer\Service\FreshdeskService">
            <argument type="service" id="Symfony\Contracts\HttpClient\HttpClientInterface"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="log_entry.repository"/>
        </service>

        <service id="CodeCom\FreshdeskSyncCustomer\Service\CustomerSyncService">
            <argument type="service" id="CodeCom\FreshdeskSyncCustomer\Service\FreshdeskService"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="customer.repository"/>
            <argument type="service" id="log_entry.repository"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="CodeCom\FreshdeskSyncCustomer\Subscriber\CustomerRegistrationSubscriber">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="CodeCom\FreshdeskSyncCustomer\Service\CustomerSyncService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="CodeCom\FreshdeskSyncCustomer\Command\SyncCustomersCommand">
            <argument type="service" id="CodeCom\FreshdeskSyncCustomer\Service\CustomerSyncService"/>
            <tag name="console.command"/>
        </service>

        <service id="CodeCom\FreshdeskSyncCustomer\Schedule\FreshdeskCustomerSyncTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="CodeCom\FreshdeskSyncCustomer\Schedule\FreshdeskCustomerSyncTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="CodeCom\FreshdeskSyncCustomer\Service\CustomerSyncService"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="CodeCom\FreshdeskSyncCustomer\Core\Api\FreshdeskCustomerSyncController" public="true">
            <argument type="service" id="CodeCom\FreshdeskSyncCustomer\Service\CustomerSyncService"/>
            <tag name="controller.service_arguments"/>
        </service>
    </services>
</container>
